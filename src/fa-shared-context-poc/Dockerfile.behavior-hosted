FROM python:3.11.14-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/home/session
WORKDIR /app
COPY requirements-hosted.txt .
RUN pip install --no-cache-dir -r requirements-hosted.txt \
    && useradd --create-home --uid 10001 app \
    && install -d -m 0755 /home/session
COPY shared_context ./shared_context
COPY hosted_bootstrap.py behavior_server_main.py ./
# UID0 only prepares the guarded private directory; exec runs with UID10001,
# cleared groups/capabilities, unchanged platform HOME and native MI identity.
USER 0
EXPOSE 8088
CMD ["python", "behavior_server_main.py", "hosted-bootstrap"]
