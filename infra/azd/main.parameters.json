{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "modelCapacityJson": {
      "value": "${FA_MODEL_CAPACITY_JSON}"
    },
    "modelDeploymentNames": {
      "value": "${FA_MODEL_DEPLOYMENTS}"
    },
    "modelVersionUpgradeOption": {
      "value": "${FA_MODEL_VERSION_UPGRADE_OPTION=NoAutoUpgrade}"
    },
    "apiSubnetNatEgress": {
      "value": "${FA_API_SUBNET_NAT_EGRESS=false}"
    },
    "enableAgentOnboarding": {
      "value": "${FA_ENABLE_AGENT_ONBOARDING=true}"
    },
    "enableTeamMcpConnections": {
      "value": "${FA_ENABLE_TEAM_MCP_CONNECTIONS=true}"
    },
    "deployUpgradeSnapshots": {
      "value": "${FA_DEPLOY_UPGRADE_SNAPSHOTS=false}"
    },
    "networkMode": {
      "value": "${FA_NETWORK_MODE=public}"
    },
    "memoryBackend": {
      "value": "${FA_MEMORY_BACKEND=foundry}"
    },
    "vnetResourceId": {
      "value": "${FA_VNET_RESOURCE_ID}"
    },
    "apiSubnetName": {
      "value": "${FA_API_SUBNET_NAME=snet-api}"
    },
    "agentSubnetName": {
      "value": "${FA_AGENT_SUBNET_NAME=snet-agents}"
    },
    "privateEndpointSubnetName": {
      "value": "${FA_PRIVATE_ENDPOINT_SUBNET_NAME=snet-private-endpoints}"
    },
    "dnsMode": {
      "value": "${FA_DNS_MODE=azd}"
    }
  }
}
